# .gitignore: files git should never track or commit.
# Each line is a pattern. "/x" = only at the repo root; "*.x" = anywhere.

# Build output from cargo (large, and rebuilt from source anyway)
/target/

# macOS Finder metadata (can reveal folder names from your Mac)
.DS_Store

# Editor and IDE settings
.vscode/
.idea/
*.swp

# Environment / secret files. This project has no secrets today (it only
# talks to the local Music.app), but if one is ever added it must never be
# committed. A documented example file would be allowed.
.env
.env.*
!.env.example

# Personal settings. am reads them from ~/.config/am/config.toml, never from
# here, but if a copy is ever made in the project it stays out of git.
# (config.example.toml, with made-up names, is the shared template.)
/config.toml

# Logs and temp files: these could contain your song/playlist names
*.log
*.tmp
/logs/

# Anything that looks like a key or certificate
*.pem
*.key
*.p12
